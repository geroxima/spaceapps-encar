---
import Layout from "@/Layout.astro";
import { links } from "@/data/links";
import InstagramIcon from "@/components/icons/instagram.astro";
import WhatsAppsIcon from "@/components/icons/whatsapp.astro";
import RegisterIcon from "@/components/icons/userplus.astro";
import MailIcon from "@/components/icons/mail.astro";
import WebIcon from "@/components/icons/planet.astro";
---

<Layout>
  <main
    class="flex min-h-screen flex-col items-center justify-center bg-electricBlue px-4 py-16"
  >
    <div class="mb-10 text-center">
      <img
        src="/images/local-logo.webp"
        alt="Logo NASA Space Apps Challenge Encarnación"
        height="10px"
        class="sm:h-30 mx-auto mb-2 h-20 w-auto"
      />
      <h1
        class="font-firaSansBlack text-3xl font-black uppercase tracking-wider text-white sm:text-4xl md:text-5xl"
      >
        Links Rápidos
      </h1>
      <p class="mt-3 font-overpass text-lg text-white">
        NASA Space Apps Challenge Encarnación 2026
      </p>
      <p class="mt-3 font-overpass text-lg text-white">
        14 y 15 de Noviembre, Auditorio de la Universidad Nacional de Itapúa
      </p>
    </div>

    <div class="flex w-full max-w-md flex-col gap-4">
      {
        links.map((link) => (
          <a
            href={link.url}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class:list={[
              "group flex items-center gap-4 rounded-2xl px-6 font-overpassBold font-bold transition-all duration-200 active:scale-95",
              link.featured
                ? "bg-neonYellow py-5 text-xl text-deepBlue shadow-lg shadow-neonYellow/25 hover:scale-[1.02] hover:shadow-neonYellow/40"
                : "bg-white/10 py-4 text-lg text-white backdrop-blur-sm hover:bg-neonYellow hover:text-deepBlue",
            ]}
          >
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-white/15 transition-colors duration-200 group-hover:bg-deepBlue/10">
              {link.icon === "register" && <RegisterIcon />}
              {link.icon === "website" && <WebIcon />}
              {link.icon === "instagram" && <InstagramIcon />}
              {link.icon === "whatsapp" && <WhatsAppsIcon />}
              {link.icon === "email" && <MailIcon />}
            </span>
            <span>{link.label}</span>
          </a>
        ))
      }
    </div>
  </main>
</Layout>

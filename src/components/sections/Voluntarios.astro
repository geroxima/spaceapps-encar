---
import Container from "@/components/Container.astro";
import { Image } from "astro:assets";
import voluntarios from "/public/images/volunteer.png";
---

<section
  id="voluntarios"
  class="relative flex flex-col items-center justify-center overflow-hidden bg-blueYonder bg-[url(/orbits.svg)] bg-cover bg-center px-4 py-20 text-white"
>
  <Container>
    <div class="z-10 flex flex-col items-center gap-8 lg:flex-row lg:gap-12">
      <!-- Text Content - Left Side -->
      <div class="flex-1 text-center lg:text-left">
        <h1
          class="mb-8 font-firaSansBlack text-3xl tracking-wide sm:text-4xl md:text-5xl lg:text-6xl"
        >
          VOLUNTARIOS
        </h1>

        <p
          class="mb-12 font-overpass text-lg leading-relaxed sm:text-xl md:text-2xl"
        >
          ¿Querés vivir el Space Apps desde adentro? Sumate como voluntario y
          ayudá a que el NASA Space Apps Challenge Encarnación 2025 sea un
          éxito. Colaborá en logística, comunicación, asistencia técnica y más.
          No necesitás experiencia, solo ganas de aportar.
        </p>

        <div class="flex justify-center lg:justify-start">
          <a
            href="https://docs.google.com/forms/d/e/1FAIpQLScpI5Kf__kVBWRNw47ybiZQ3egAYLuKVobh3ex4Z9WUDt9aCg/viewform?usp=header"
            target="_blank"
            rel="noreferrer"
            class="transform rounded-lg bg-neonYellow px-8 py-4 font-overpassBold text-lg font-bold text-black transition duration-200 hover:bg-[#C7D806] sm:px-10 sm:py-5 sm:text-xl md:text-2xl"
          >
            QUIERO SER VOLUNTARIO
          </a>
        </div>
      </div>

      <!-- Image - Right Side -->
      <div class="flex flex-1 justify-center lg:justify-end">
        <div class="w-full max-w-md lg:max-w-none">
          <Image
            src={voluntarios}
            alt="Voluntarios del NASA Space Apps Challenge"
            class="h-auto w-full rounded-md object-cover"
          />
        </div>
      </div>
    </div>
  </Container>

  <div class="absolute inset-0 z-0 h-full w-full bg-blueYonder bg-opacity-95">
  </div>
</section>

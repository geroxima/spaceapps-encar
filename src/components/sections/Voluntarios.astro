---
import Container from "@/components/Container.astro";
import { Image } from "astro:assets";
import voluntarios from "@/assets/volunteer.png";
---

<section
  id="voluntarios"
  class="relative flex scroll-mt-28 flex-col items-center justify-center overflow-hidden border-t border-electricBlue/10 bg-white bg-[url(/orbits.svg)] bg-cover bg-center px-4 py-20"
>
  <Container>
    <div class="z-10 flex flex-col items-center gap-8 lg:flex-row lg:gap-12">
      <!-- Text Content - Left Side -->
      <div class="flex-1 text-center lg:text-left">
        <h1
          class="mb-6 font-firaSansBlack text-3xl uppercase tracking-wide text-deepBlue sm:text-4xl md:text-5xl lg:text-6xl"
        >
          Voluntarios
        </h1>

        <p
          class="mb-10 font-overpass text-lg leading-relaxed text-gray-600 sm:text-xl md:text-2xl"
        >
          ¿Querés vivir el Space Apps desde adentro? Sumate como voluntario y
          ayudá a que el NASA Space Apps Challenge Encarnación 2026 sea un
          éxito. Colaborá en logística, comunicación, asistencia técnica y más.
          No necesitás experiencia, solo ganas de aportar.
        </p>

        <div class="flex justify-center lg:justify-start">
          <a
            href="https://docs.google.com/forms/d/e/1FAIpQLSfU7KRuAJHs5taTU83RRN3O1YY6UsGOTkQP1mgnR7FrnbO10w/viewform?usp=dialog"
            target="_blank"
            rel="noreferrer"
            class="transform rounded-lg bg-neonYellow px-8 py-4 font-overpassBold text-lg font-bold text-black shadow-lg shadow-neonYellow/40 transition duration-200 hover:bg-[#C7D806] sm:px-10 sm:py-5 sm:text-xl md:text-2xl"
          >
            QUIERO SER VOLUNTARIO
          </a>
        </div>
      </div>

      <!-- Image - Right Side -->
      <div class="flex flex-1 justify-center lg:justify-end">
        <div class="w-full max-w-md lg:max-w-none">
          <Image
            src={voluntarios}
            alt="Voluntarios del NASA Space Apps Challenge"
            class="h-auto w-full rounded-2xl object-cover shadow-xl shadow-deepBlue/10 ring-1 ring-electricBlue/10"
          />
        </div>
      </div>
    </div>
  </Container>
  <div class="absolute inset-0 z-0 h-full w-full bg-white bg-opacity-80"></div>
</section>

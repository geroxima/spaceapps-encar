---
import Calendar from "@/components/icons/calendar.astro";
import Container from "@/components/Container.astro";
import PinLocation from "@/components/icons/pin.astro";
---

<section id="lugar-y-fecha" class="bg-electricBlue">
  <Container>
    <div
      class="flex flex-col gap-y-8 md:flex-row md:justify-between md:gap-y-0"
    >
      <div class="flex flex-col gap-y-4 md:w-1/2">
        <h3 class="font-firaSansBlack text-3xl text-white md:text-5xl">
          FECHA
        </h3>
        <p class="font-overpass text-xl font-medium text-white md:text-2xl">
          4 y 5 de octubre, desde las 09:00hs GMT -3
        </p>
        <a
          href="./NASA-Space-Apps-Challenge-Encarnacion-2025.ics"
          target="_blank"
          rel="noopener noreferrer"
          download="NASA Space Apps Challenge Encarnación 2025"
          class="flex items-center gap-x-2 font-overpassBold text-base font-bold text-neonYellow underline md:text-lg"
          ><span>GUARDAR EN CALENDARIO</span><Calendar /></a
        >
      </div>
      <div class="mt-8 flex flex-col justify-around gap-y-4 md:mt-0 md:w-1/2">
        <h3 class="font-firaSansBlack text-3xl text-white md:text-5xl">
          LUGAR
        </h3>
        <p class="font-overpass text-xl font-medium text-white md:text-2xl">
          Auditorio Central de la Universidad Nacional de Itapúa (UNI)
        </p>
        <p class="font-overpass text-xl font-medium text-white md:text-2xl">
          Campus Encarnación
        </p>
        <a
          href="https://maps.app.goo.gl/EaNcJ49MU32z26g76"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-x-2 font-overpassBold text-base font-bold text-neonYellow underline md:text-lg"
          ><span>VER EN EL MAPA</span><PinLocation /></a
        >
      </div>
    </div>
  </Container>
</section>

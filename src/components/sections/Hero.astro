---
import RegisterButton from "@/components/RegisterButton.astro";
import Container from "@/components/Container.astro";
import { Image } from "astro:assets";
import heroLogo from "@/assets/the-next-frontier-logo.webp";
import Rocket from "@/components/icons/rocket.astro";
import Calendar from "@/components/icons/calendar.astro";
import ArrowUpRight from "@/components/icons/arrow-up-right.astro";
import Trophy from "../icons/trophy.astro";

const stats = [
  { value: "167", label: "Países participantes" },
  { value: "114k+", label: "Participantes internacionales" },
  { value: "5", label: "Equipos ganadores" },
];
---

<section id="inicio" class="section-bg flex min-h-screen scroll-mt-28 flex-col">
  <Container
    class="relative z-10 flex w-full max-w-7xl flex-1 items-center justify-center gap-7 pb-12 pt-28 sm:gap-8 sm:pb-10 sm:pt-28 lg:flex-row lg:gap-10 xl:gap-16"
  >
    <div class="animate-fade-in shrink-0">
      <Image
        src={heroLogo}
        alt="The Next Frontier"
        width={500}
        height={500}
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full max-w-[200px] drop-shadow-[0_0_30px_rgba(46,150,245,0.4)] sm:max-w-[270px] lg:w-[clamp(230px,23vw,350px)] lg:max-w-none xl:w-[clamp(330px,27vw,450px)]"
      />
    </div>

    <div
      class="animate-fade-in flex min-w-0 max-w-xl flex-col items-center gap-5 text-center [animation-delay:200ms] sm:gap-5 lg:max-w-none lg:flex-1 lg:items-start lg:text-left xl:gap-6"
    >
      <h1
        class="font-firaSansBlack text-3xl uppercase leading-[1.1] tracking-wide text-white sm:text-5xl lg:text-4xl xl:text-6xl 2xl:text-7xl"
      >
        NASA Space Apps Challenge<br />
        <span class="bg-neonYellow px-3 text-deepBlue">Encarnación 2026</span>
      </h1>

      <div
        class="flex items-start justify-center gap-x-2 text-white/90 lg:justify-start"
      >
        <Calendar class="mt-0.5 shrink-0 xl:mt-1 xl:size-7" />
        <span
          class="my-auto text-center text-sm font-bold sm:text-left sm:text-lg xl:text-2xl"
        >
          14 y 15 de Noviembre · Auditorio Central de la UNI
        </span>
      </div>

      <h2
        class="max-w-xl text-sm leading-relaxed text-white/90 md:text-lg lg:max-w-none lg:leading-normal xl:text-2xl"
      >
        Desarrolla herramientas innovadoras que beneficien a la humanidad y
        contribuyan a la ciencia y tecnología que nos impulsa hacia la
        <span class="font-bold text-neonYellow">Luna, Marte y más allá.</span>
      </h2>

      <div
        class="flex flex-col items-center gap-4 pt-3 sm:flex-row sm:flex-wrap sm:justify-center lg:justify-start lg:gap-4 xl:gap-5"
      >
        <RegisterButton variant="hero">
          <Rocket class="h-5 w-5 sm:h-6 sm:w-6" />
        </RegisterButton>
        <a
          href="#ganadores"
          class="flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-xl border-2 border-white/40 px-8 py-4 font-overpassBold text-base font-bold text-white transition-all duration-200 hover:scale-105 hover:bg-white hover:text-deepBlue sm:w-auto sm:px-8 sm:text-lg"
        >
          <span>VER GANADORES 2025</span>
          <Trophy class="size-5" />
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  .section-bg {
    position: relative;
    background-image: url("/images/hero-bg.webp");
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    opacity: 0;
    animation: fadeIn 1.5s forwards ease-out;
  }

  .section-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at center,
        transparent 0%,
        rgba(7, 23, 63, 0.8) 100%
      ),
      rgba(0, 0, 0, 0.4);
  }
  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  .animate-fade-in {
    animation: fadeIn 1s ease-out forwards;
  }
</style>

---
import Container from "@/components/Container.astro";
import RegisterButton from "@/components/RegisterButton.astro";
---

<section
  class="bg-white bg-[url(/rosette.svg)] bg-cover bg-center py-16"
  id="registro"
>
  <Container>
    <div class="space-y-8 text-center">
      <p
        class="font-overpassBold text-sm uppercase tracking-[0.2em] text-electricBlue"
      >
        Cómo participar
      </p>
      <h1
        class="font-firaSansBlack text-3xl uppercase tracking-wide text-deepBlue sm:text-4xl"
      >
        Mira este breve video de cómo <span class="text-neonBlue"
          >registrarte</span
        >
      </h1>

      <div class="mx-auto max-w-4xl">
        <lite-youtube
          class="rounded-lg"
          videoid="_AL3QrPBugc"
          videotitle="NASA Space Apps Challenge - Tutorial de Registro"
        >
        </lite-youtube>
      </div>

      <RegisterButton variant="tutorial" />
    </div>
  </Container>

  <script>
    import "@justinribeiro/lite-youtube";
  </script>
</section>

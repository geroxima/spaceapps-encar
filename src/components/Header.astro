---
import Image from "astro/components/Image.astro";
import localLogo from "public/images/local-logo.webp";
// You'll need to create these icon components or replace with your own
// import HamburgerMenu from "@/icons/HamburgerMenu.astro";
// import Close from "@/icons/Close.astro";

const sections = [
  { name: "Regístrate", href: "#registro" },
  { name: "Jurados", href: "#jurados" },
  { name: "Acerca De", href: "#acerca" },
  { name: "Lugar y Fecha", href: "#lugar-y-fecha" },
  { name: "Colaboradores", href: "#colaboradores" },
  { name: "Voluntarios", href: "#voluntarios" },
];
---

<header class="header-fixed">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between py-4">
      <!-- Logo -->
      <a href="#" aria-label="Ir a la página de inicio" class="flex-shrink-0">
        <img
          src="/images/local-logo.webp"
          width="100"
          height="100"
          alt="Local event logo"
          class="rounded-lg"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden items-center gap-8 lg:flex">
        {
          sections.map(({ name, href }) => (
            <a
              href={href}
              class="nav-link font-overpassBold text-sm font-bold uppercase tracking-wide text-white transition-colors duration-200 hover:text-neonYellow"
            >
              {name}
            </a>
          ))
        }

        <!-- Desktop CTA Button -->
        <a
          href="https://www.spaceappschallenge.org/2025/local-events/Encarnacion/"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-4 whitespace-nowrap rounded-lg bg-neonYellow px-4 py-2 text-sm font-bold text-black transition-all duration-200 hover:scale-105 hover:bg-[#C7D806]"
        >
          REGISTRARSE
        </a>
      </nav>

      <!-- Mobile Hamburger Menu -->
      <button
        aria-label="Abrir menú"
        class="p-2 text-white lg:hidden"
        id="menuButton"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    class="pointer-events-none fixed inset-0 z-[888] flex h-[100dvh] w-screen flex-col items-center overflow-x-auto bg-deepBlue/95 opacity-0 backdrop-blur-3xl transition-opacity duration-300 lg:hidden"
    id="menuMobileContent"
  >
    <aside class="flex w-full items-center justify-end px-6 pt-6">
      <button
        aria-label="Cerrar menú"
        id="innerMenuButton"
        class="p-2 text-white"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </aside>
    <nav class="mb-6 mt-auto flex w-full flex-col items-start gap-5 px-6">
      {
        sections.map(({ name, href }, key) => (
          <a
            href={href}
            class="font-overpassBold text-4xl font-bold uppercase tracking-tighter text-white transition-all duration-75 ease-out hover:text-rocketRed hover:underline"
            id={`navmob-link-${key}`}
          >
            {name}
          </a>
        ))
      }

      <!-- Mobile CTA Button -->
      <a
        href="https://www.spaceappschallenge.org/2025/local-events/Encarnacion/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 w-full rounded-lg bg-neonYellow px-6 py-3 text-center text-xl font-bold uppercase tracking-wider text-black transition-all duration-200 hover:bg-[#C7D806]"
      >
        REGISTRARSE AHORA
      </a>
    </nav>
  </div>
</header>

<style>
  .header-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 999;
    backdrop-filter: blur(8px);
    background-color: rgba(7, 23, 63, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .nav-link:hover {
    text-decoration: underline;
  }

  #menuMobileContent {
    backdrop-filter: blur(8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  #menuMobileContent.open {
    opacity: 1;
    pointer-events: all;
  }
</style>

<script>
  function toggleMenu() {
    const menuContent = document.getElementById("menuMobileContent");
    const menuButton = document.getElementById("menuButton");
    const innerMenuButton = document.getElementById("innerMenuButton");

    menuContent?.classList.toggle("open");
    document.body.classList.toggle("overflow-hidden");

    menuButton?.classList.toggle("hidden");
    innerMenuButton?.classList.toggle("open");
  }

  window.onload = () => {
    const menuContent = document.getElementById("menuMobileContent");
    const menuButton = document.getElementById("menuButton");
    const innerMenuButton = document.getElementById("innerMenuButton");

    menuButton?.addEventListener("click", toggleMenu);
    innerMenuButton?.addEventListener("click", toggleMenu);

    const linksMobile = document.querySelectorAll("a[id^='navmob-link-']");
    linksMobile.forEach((link) =>
      link.addEventListener("click", () => {
        toggleMenu();
      }),
    );
  };
</script>

---
import { Image } from "astro:assets";
import Container from "@/components/Container.astro";
import logo from "public/images/local-logo.webp";
---

<footer class="bg-black text-white">
  <Container class="flex flex-col gap-10 2xl:flex-row">
    <aside
      class="mb-10 flex w-full flex-col items-center 2xl:mb-0 2xl:w-1/2 2xl:items-start"
    >
      <img
        src="/images/local-logo.webp"
        width="120"
        height="120"
        alt="NASA Space Apps Challenge Logo"
        class="mb-4"
      />
      <p class="mb-6 text-center text-sm md:text-base 2xl:text-left">
        2025 NASA Space Apps Challenge | Evento Local: Encarnación
      </p>

      <!-- Registration CTA -->
      <div class="mb-6">
        <a
          href="#registro"
          class="inline-block transform rounded-lg bg-neonYellow px-8 py-4 font-overpassBold text-lg font-bold text-black transition duration-200 hover:bg-[#C7D806]"
        >
          ¡REGÍSTRATE AHORA!
        </a>
      </div>

      <a
        href="https://spaceappschallenge.org"
        target="_blank"
        rel="noopener noreferrer"
        class="text-center text-sm transition-all duration-75 ease-out hover:text-rocketRed hover:underline md:text-base 2xl:text-left"
        >spaceappschallenge.org</a
      >
    </aside>

    <div class="flex w-full flex-col justify-around gap-10 md:flex-row">
      <div class="flex flex-col items-center gap-y-2 md:items-start">
        <h3 class="mb-4 text-lg font-bold text-white md:mb-10">Contacto</h3>
        <a
          href="mailto:info@spaceappsencarnacion.live"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm transition-all duration-75 ease-out hover:text-rocketRed hover:underline md:text-base"
          >info@spaceappsencarnacion.live</a
        >
        <a
          href="tel:+595994177042"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm transition-all duration-75 ease-out hover:text-rocketRed hover:underline md:text-base"
          >+595 994 177042</a
        >
      </div>
      <div class="flex flex-col items-center gap-y-2 md:items-start">
        <h4 class="mb-4 text-lg font-bold text-white md:mb-10">
          Redes Sociales
        </h4>
        <a
          href="https://instagram.com/nsacencar"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm transition-all duration-75 ease-out hover:text-rocketRed hover:underline md:text-base"
          >Instagram</a
        >
        <a
          href="https://x.com/nsacencar"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm transition-all duration-75 ease-out hover:text-rocketRed hover:underline md:text-base"
          >X (Twitter)</a
        >
      </div>
    </div>
  </Container>
</footer>

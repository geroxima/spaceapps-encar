---
import sponsorsData from "@/data/collaborators.json";
import Container from "@/components/Container.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const icons: Record<string, string> = {
  galaxia: "galaxy",
  "sistema-solar": "meteor",
  planeta: "planet",
  satelite: "satellite",
  apoyan: "rocket",
};

const classes: Record<string, string> = {
  galaxia: "grid-cols-1 md:grid-cols-1",
  "sistema-solar": "grid-cols-1 md:grid-cols-2",
  planeta: "grid-cols-2 md:grid-cols-3",
  satelite: "grid-cols-2 md:grid-cols-4",
  apoyan: "grid-cols-2 md:grid-cols-3",
};
---

<section
  class="relative flex scroll-mt-28 flex-col bg-[url(fiduciaries.svg)] bg-cover bg-center font-overpassBold text-deepBlue"
>
  <Container id="colaboradores">
    <div
      class="px-section mb-12 flex flex-col items-center justify-between gap-12 md:flex-row"
    >
      <div class="flex-1">
        <p class="uppercase text-gray-500">Nuestros Colaboradores</p>
        <h3 class="xs:text-6xl text-balance text-5xl font-medium">
          Agradecemos la confianza de los que están ayudando a que este evento
          se lleve a cabo
        </h3>
      </div>
      <div class="flex-shrink-0">
        <a
          href="mailto:info@nasaencar.com"
          class="flex transform items-center gap-x-2 whitespace-nowrap rounded-lg bg-neonYellow px-8 py-4 font-overpassBold text-lg font-bold text-black transition duration-200 hover:scale-105 hover:bg-[#C7D806]"
        >
          <span>QUIERO SER COLABORADOR</span>
          <Icon name="arrow-up-right" />
        </a>
      </div>
    </div>

    {
      sponsorsData &&
        sponsorsData
          .filter((group) =>
            group.subcategories.some(
              (sponsor) => sponsor.companies && sponsor.companies.length > 0,
            ),
          )
          .map((group) => (
            <div class="mb-12">
              <h2 class="mb-8 text-center font-overpassBold text-3xl font-bold text-gray-800">
                {group.category}
              </h2>
              {group.subcategories
                .filter(
                  (sponsor) =>
                    sponsor.companies && sponsor.companies.length > 0,
                )
                .map((sponsor) => (
                  <div class="px-section col-span-1 mb-8 flex flex-col gap-4 text-gray-700">
                    <div class="flex items-center justify-end gap-1">
                      <div class="flex w-full items-center">
                        <div class="w-auto flex-1 flex-grow border-t border-gray-300" />
                        <div
                          class="w-100 ml-4 flex items-center gap-2"
                          style={{ color: sponsor.color }}
                        >
                          <span>{sponsor.tier}</span>
                          {icons[sponsor.icon] && (
                            <Icon name={icons[sponsor.icon]} class="size-4" />
                          )}
                        </div>
                      </div>
                    </div>
                    <div
                      class:list={[
                        "grid items-center justify-center gap-4 pb-4",
                        classes[sponsor.icon],
                      ]}
                    >
                      {sponsor.companies.map((company) => (
                        <a
                          class:list={[
                            "mx-auto flex w-full items-center justify-center p-2 transition-transform hover:scale-110",
                            sponsor.icon === "satelite" ||
                            sponsor.icon === "apoyan"
                              ? "max-w-40"
                              : sponsor.icon === "planeta"
                                ? "max-w-48"
                                : "max-w-96",
                          ]}
                          href={company.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <Image
                            width={192}
                            height={96}
                            src={company.image}
                            alt={company.name}
                            class="h-auto w-full object-contain"
                          />
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
            </div>
          ))
    }
  </Container>
</section>

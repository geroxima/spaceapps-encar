---
import Container from "@/components/Container.astro";
import { Icon } from "astro-icon/components";
---

<section
  id="lugar-y-fecha"
  class="relative scroll-mt-28 overflow-hidden bg-electricBlue"
>
  <div
    class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-blueYonder/25 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-32 -left-24 h-96 w-96 rounded-full bg-neonBlue/30 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <Container class="relative z-10">
    <div class="mb-10 flex flex-col items-center gap-3 text-center">
      <p
        class="font-overpassBold text-sm uppercase tracking-[0.2em] text-neonYellow"
      >
        Agenda la fecha
      </p>
      <h2
        class="font-firaSansBlack text-3xl uppercase tracking-wide text-white sm:text-4xl md:text-5xl"
      >
        Fecha y Lugar
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div
        class="flex flex-col justify-between gap-y-6 rounded-3xl border border-white/15 bg-white/10 p-8 backdrop-blur-md"
      >
        <div class="flex items-start gap-4">
          <span
            class="flex size-12 flex-shrink-0 items-center justify-center rounded-2xl bg-neonYellow/15 text-neonYellow"
          >
            <Icon name="calendar" size={24} />
          </span>
          <div>
            <h3
              class="font-firaSansBlack text-2xl uppercase tracking-wide text-white md:text-3xl"
            >
              Fecha
            </h3>
            <p
              class="mt-3 font-overpass text-xl font-medium text-white md:text-2xl"
            >
              14 y 15 de noviembre, desde las 09:00hs GMT -3
            </p>
          </div>
        </div>
        <a
          href="/NASA-Space-Apps-Challenge-Encarnacion-2026.ics"
          download="NASA Space Apps Challenge Encarnación 2026"
          class="flex items-center gap-x-2 font-overpassBold text-base font-bold text-neonYellow underline md:text-lg"
          ><span>GUARDAR EN CALENDARIO</span><Icon name="calendar" /></a
        >
      </div>

      <div
        class="flex flex-col justify-between gap-y-6 rounded-3xl border border-white/15 bg-white/10 p-8 backdrop-blur-md"
      >
        <div class="flex items-start gap-4">
          <span
            class="flex size-12 flex-shrink-0 items-center justify-center rounded-2xl bg-neonYellow/15 text-neonYellow"
          >
            <Icon name="pin" size={24} />
          </span>
          <div>
            <h3
              class="font-firaSansBlack text-2xl uppercase tracking-wide text-white md:text-3xl"
            >
              Lugar
            </h3>
            <p
              class="mt-3 font-overpass text-xl font-medium text-white md:text-2xl"
            >
              Auditorio Central de la Universidad Nacional de Itapúa (UNI)
            </p>
            <p class="font-overpass text-xl font-medium text-white md:text-2xl">
              Campus Encarnación
            </p>
          </div>
        </div>
        <a
          href="https://maps.app.goo.gl/EaNcJ49MU32z26g76"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-x-2 font-overpassBold text-base font-bold text-neonYellow underline md:text-lg"
          ><span>VER EN EL MAPA</span>
          <Icon name="pin" />
        </a>
      </div>
    </div>
  </Container>
</section>

---
import Container from "@/components/Container.astro";
import Instagram from "@/components/icons/instagram.astro";
import Facebook from "@/components/icons/facebook.astro";
import LinkedIn from "@/components/icons/linkedin.astro";
import Scholar from "@/components/icons/graduation.astro";
import Plus from "@/components/icons/plus.astro";
import judgesData from "@/data/judges.json";
---

<section
  id="jurados"
  class="relative flex scroll-mt-28 flex-col items-center justify-center overflow-hidden border-b border-electricBlue/10 bg-white bg-[url(/fiduciaries.svg)] bg-cover bg-center px-4 py-20"
>
  <div
    class="absolute inset-0 z-0 h-full w-full bg-white bg-opacity-95"
  ></div>

  <Container>
    <div class="z-10 mb-12 text-center">
      <p
        class="font-overpassBold text-sm uppercase tracking-[0.2em] text-electricBlue"
      >
        Nuestros Jurados
      </p>
      <h2
        class="mt-3 font-firaSansBlack text-3xl uppercase tracking-wide text-deepBlue sm:text-4xl md:text-5xl"
      >
        Conoce a los expertos que evaluarán los proyectos
      </h2>
    </div>

    {
      judgesData &&
        judgesData.map((group) => (
          <div class="z-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {group.judges.map((judge, index) => {
              const dialogId = `dialog-${index}`;
              const buttonId = `about-judge-${index}`;
              return (
                <div class="group relative flex flex-col gap-y-4">
                  <dialog id={dialogId} closedby="any" class="max-w-md p-6">
                    <p class="text-xl text-black md:text-base xl:text-base">
                      {judge.description}
                    </p>
                    <form method="dialog" class="flex justify-end">
                      <button class="rounded bg-electricBlue px-4 py-2 text-white transition hover:bg-neonYellow hover:text-black">
                        Cerrar
                      </button>
                    </form>
                  </dialog>

                  <div class="relative aspect-square overflow-hidden rounded-2xl bg-white shadow-xl shadow-deepBlue/10 ring-1 ring-electricBlue/10">
                    <img
                      src={judge.image}
                      alt={judge.name}
                      class="absolute inset-0 h-full w-full object-cover opacity-100 transition-opacity"
                    />

                    <button
                      id={buttonId}
                      class="absolute bottom-0 right-0 m-2 flex items-end bg-neonYellow p-4 text-black transition-all duration-75 hover:scale-110 hover:cursor-pointer lg:p-2"
                      title="Aprender más"
                      type="button"
                    >
                      <Plus />
                    </button>
                  </div>

                  <h2 class="font-firaSansBlack text-xl uppercase text-deepBlue">
                    {judge.name}
                  </h2>
                  <h3 class="flex items-center gap-2 text-gray-600">
                    {judge.country === "Perú"
                      ? "🇵🇪"
                      : judge.country === "Paraguay"
                        ? "🇵🇾"
                        : judge.country === "España"
                          ? "🇪🇸"
                          : "🌎"}{" "}
                    {judge.country}
                  </h3>
                  {judge.urls && (
                    <div class="flex flex-col gap-2">
                      {judge.urls.linkedin && (
                        <a
                          href={judge.urls.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-x-2 text-2xl text-electricBlue transition-colors hover:cursor-pointer hover:text-neonBlue md:text-xl lg:text-base xl:text-base"
                        >
                          <LinkedIn />
                          <span>LinkedIn</span>
                        </a>
                      )}
                      {judge.urls.scholar && (
                        <a
                          href={judge.urls.scholar}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-x-2 text-2xl text-electricBlue transition-colors hover:cursor-pointer hover:text-neonBlue md:text-xl lg:text-base xl:text-base"
                        >
                          <Scholar />
                          <span>Google Scholar</span>
                        </a>
                      )}
                      {judge.urls.instagram && (
                        <a
                          href={judge.urls.instagram}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-x-2 text-2xl text-electricBlue transition-colors hover:cursor-pointer hover:text-neonBlue md:text-xl lg:text-base xl:text-base"
                        >
                          <Instagram />
                          <span>Instagram</span>
                        </a>
                      )}
                      {judge.urls.facebook && (
                        <a
                          href={judge.urls.facebook}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-x-2 text-2xl text-electricBlue transition-colors hover:cursor-pointer hover:text-neonBlue md:text-xl lg:text-base xl:text-base"
                        >
                          <Facebook />
                          <span>Facebook</span>
                        </a>
                      )}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        ))
    }
  </Container>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const buttons = document.querySelectorAll("[id^='about-judge-']");

    buttons.forEach((button) => {
      const index = button.id.split("-").pop();
      const dialog = document.getElementById(`dialog-${index}`);

      if (dialog && button) {
        button.addEventListener("click", (e) => {
          e.preventDefault();
          dialog.showModal();
        });
      }
    });
  });
</script>
